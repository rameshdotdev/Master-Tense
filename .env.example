# ==============================================================================
# Google Gemini API
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls and server-side model operations.
# AI Studio automatically injects this at runtime from user secrets.
# Never commit actual secret keys to source control.
GEMINI_API_KEY=

# ==============================================================================
# Application URL & Routing
# ==============================================================================
# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ==============================================================================
# Development & Build Configuration
# ==============================================================================
# DISABLE_HMR: Disables Vite Hot Module Replacement in container sandbox.
DISABLE_HMR=true

# NODE_ENV: Application runtime mode ('development' or 'production').
NODE_ENV=development

# ==============================================================================
# Firebase & Authentication (Client-Side Configuration)
# ==============================================================================
# In AI Studio, Firebase configuration is automatically read from firebase-applet-config.json.
# For standalone local development or custom deployments, configure these VITE_ variables:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
